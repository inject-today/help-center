---
// The home page search box: suggests products as you type, and hands
// anything else over to the site-wide guide search.
import ProductIcon from './ProductIcon.astro';
import { platformsLabel, productHref, products } from '../lib/products';

const searchIcon =
	'M21.7 20.3 18 16.6A8.5 8.5 0 1 0 16.6 18l3.7 3.7a1 1 0 0 0 1.4-1.4ZM4.5 10.5a6 6 0 1 1 6 6 6 6 0 0 1-6-6Z';
---

<div class="finder" data-finder>
	<div class="field">
		<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
			<path fill="currentColor" d={searchIcon}></path>
		</svg>
		<input
			type="text"
			role="combobox"
			aria-label="Find your product"
			aria-autocomplete="list"
			aria-expanded="false"
			aria-controls="finder-options"
			placeholder="Find your product"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			enterkeyhint="go"
			data-input
		/>
		<kbd aria-hidden="true">/</kbd>
	</div>

	<div class="panel" data-panel hidden>
		<ul id="finder-options" role="listbox" aria-label="Products">
			{
				products.map((product) => (
					<li
						id={`finder-${product.slug}`}
						role="option"
						aria-selected="false"
						data-option
						data-name={product.name}
						data-href={productHref(product)}
						hidden
					>
						<ProductIcon product={product} size={30} />
						<span class="option-name">{product.name}</span>
						<span class="it-meta">{platformsLabel(product)}</span>
					</li>
				))
			}
			<li id="finder-guides" role="option" aria-selected="false" data-option data-guides>
				<span class="guides-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="15" height="15">
						<path fill="currentColor" d={searchIcon}></path>
					</svg>
				</span>
				<span class="option-name">
					Search all guides for <q data-query-echo></q>
				</span>
			</li>
		</ul>
	</div>
</div>

<script>
	const MAX_PRODUCTS = 6;
	// "synapsez" finds "Synapse Z", "dx9" finds "DX9WARE V2".
	const compact = (value: string) => value.toLowerCase().replace(/[^a-z0-9]/g, '');

	for (const finder of document.querySelectorAll<HTMLElement>('[data-finder]')) {
		const input = finder.querySelector<HTMLInputElement>('[data-input]')!;
		const panel = finder.querySelector<HTMLElement>('[data-panel]')!;
		const listbox = panel.querySelector<HTMLElement>('[role="listbox"]')!;
		const guides = finder.querySelector<HTMLElement>('[data-guides]')!;
		const echo = finder.querySelector<HTMLElement>('[data-query-echo]')!;
		const products = [...finder.querySelectorAll<HTMLElement>('[data-option]:not([data-guides])')].map(
			(option) => ({
				option,
				name: compact(option.dataset.name!),
				words: option.dataset.name!.toLowerCase().split(/\s+/).map(compact),
			})
		);
		let visible: HTMLElement[] = [];
		let active = -1;

		const setActive = (index: number) => {
			visible[active]?.setAttribute('aria-selected', 'false');
			active = index;
			const option = visible[active];
			if (option) {
				option.setAttribute('aria-selected', 'true');
				input.setAttribute('aria-activedescendant', option.id);
				option.scrollIntoView({ block: 'nearest' });
			} else {
				input.removeAttribute('aria-activedescendant');
			}
		};

		const close = () => {
			panel.hidden = true;
			input.setAttribute('aria-expanded', 'false');
			setActive(-1);
		};

		const update = () => {
			const raw = input.value.trim();
			const query = compact(raw);
			if (!query) return close();

			// Names that start with the query first, then a word that does, then anywhere.
			const rank = ({ name, words }: (typeof products)[number]) =>
				name.startsWith(query) ? 0 : words.some((w) => w.startsWith(query)) ? 1 : name.includes(query) ? 2 : -1;
			const matches = products
				.map((p) => ({ ...p, score: rank(p) }))
				.filter((p) => p.score >= 0)
				.sort((a, b) => a.score - b.score)
				.slice(0, MAX_PRODUCTS);

			for (const { option } of products) option.hidden = true;
			for (const { option } of matches) {
				option.hidden = false;
				listbox.insertBefore(option, guides);
			}
			echo.textContent = raw;
			guides.toggleAttribute('data-alone', matches.length === 0);
			visible = [...matches.map((m) => m.option), guides];
			panel.hidden = false;
			input.setAttribute('aria-expanded', 'true');
			setActive(0);
		};

		const choose = (option: HTMLElement | undefined) => {
			if (!option) return;
			if (option === guides) {
				const query = input.value.trim();
				close();
				document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
				const search = document.querySelector<HTMLInputElement>('#starlight__search input');
				if (search && query) {
					search.value = query;
					search.dispatchEvent(new Event('input', { bubbles: true }));
				}
				return;
			}
			window.location.href = option.dataset.href!;
		};

		input.addEventListener('input', update);
		input.addEventListener('focus', () => input.value.trim() && update());
		input.addEventListener('blur', close);
		input.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
				if (panel.hidden) return update();
				event.preventDefault();
				const step = event.key === 'ArrowDown' ? 1 : -1;
				setActive((active + step + visible.length) % visible.length);
			} else if (event.key === 'Enter') {
				if (panel.hidden) return;
				event.preventDefault();
				choose(visible[active]);
			} else if (event.key === 'Escape') {
				if (!panel.hidden) close();
				else input.value = '';
			}
		});

		// Keep focus in the field while picking with the pointer.
		listbox.addEventListener('pointerdown', (event) => event.preventDefault());
		listbox.addEventListener('click', (event) => {
			// Starlight closes its search dialog on any click outside it, including this one.
			event.stopPropagation();
			choose((event.target as HTMLElement).closest<HTMLElement>('[data-option]') ?? undefined);
		});
		listbox.addEventListener('pointermove', (event) => {
			const option = (event.target as HTMLElement).closest<HTMLElement>('[data-option]');
			const index = option ? visible.indexOf(option) : -1;
			if (index >= 0 && index !== active) setActive(index);
		});

		// "/" jumps to the finder from anywhere on the page, like most search boxes.
		document.addEventListener('keydown', (event) => {
			if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
			const target = event.target as HTMLElement;
			if (target.closest('input, textarea, select, [contenteditable="true"], dialog[open]')) return;
			event.preventDefault();
			input.focus();
		});
	}
</script>

<style>
	.finder {
		position: relative;
		max-inline-size: 36rem;
		z-index: 2;
	}

	.field {
		position: relative;
		display: flex;
		align-items: center;
		color: var(--sl-color-gray-3);
	}
	.field svg {
		position: absolute;
		inset-inline-start: 1.125rem;
		pointer-events: none;
	}
	input {
		inline-size: 100%;
		block-size: 3.25rem;
		padding: 0 3rem 0 2.875rem;
		border: 0;
		border-radius: var(--it-radius);
		font: inherit;
		/* 16px or more keeps iOS Safari from zooming into the field. */
		font-size: max(1.0625rem, 16px);
		color: var(--sl-color-white);
		background: var(--it-surface);
		box-shadow:
			inset 0 0 0 1px var(--it-edge-strong),
			var(--it-shadow);
		transition: box-shadow 150ms ease;
		-webkit-appearance: none;
		appearance: none;
	}
	input::placeholder {
		color: var(--sl-color-gray-3);
	}
	input:focus {
		outline: none;
		box-shadow:
			inset 0 0 0 1px var(--sl-color-gray-3),
			0 0 0 4px color-mix(in oklab, var(--sl-color-white) 9%, transparent),
			var(--it-shadow);
	}
	kbd {
		position: absolute;
		inset-inline-end: 1rem;
		display: grid;
		place-items: center;
		inline-size: 1.5rem;
		block-size: 1.5rem;
		border-radius: 0.375rem;
		box-shadow: inset 0 0 0 1px var(--it-edge-strong);
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-2xs);
		color: var(--sl-color-gray-3);
		pointer-events: none;
	}
	input:focus ~ kbd,
	input:not(:placeholder-shown) ~ kbd {
		visibility: hidden;
	}
	@media (hover: none) {
		kbd {
			display: none;
		}
	}

	/* Opens instantly: it appears on every keystroke, so motion would only lag behind typing. */
	.panel {
		position: absolute;
		inset: calc(100% + 0.5rem) 0 auto;
		padding: 0.375rem;
		border-radius: var(--it-radius);
		background: var(--it-surface-raised);
		box-shadow:
			inset 0 0 0 1px var(--it-edge-strong),
			var(--it-shadow-lift);
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	[role='option'] {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-block-size: 2.75rem;
		padding: 0.375rem 0.625rem 0.375rem 0.4375rem;
		border-radius: var(--it-radius-sm);
		color: var(--sl-color-gray-1);
		cursor: pointer;
	}
	[role='option'][hidden] {
		display: none;
	}
	[role='option'][aria-selected='true'] {
		color: var(--sl-color-white);
		background: color-mix(in oklab, var(--sl-color-white) 8%, transparent);
	}
	.option-name {
		flex: 1;
		min-inline-size: 0;
		overflow: hidden;
		font-weight: 550;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	[data-guides] {
		margin-top: 0.25rem;
		border-top: 1px solid var(--it-edge);
		border-radius: 0 0 var(--it-radius-sm) var(--it-radius-sm);
	}
	[data-guides][data-alone] {
		margin-top: 0;
		border-top: 0;
		border-radius: var(--it-radius-sm);
	}
	.guides-icon {
		display: grid;
		place-items: center;
		inline-size: 30px;
		block-size: 30px;
		border-radius: 0.5rem;
		box-shadow: inset 0 0 0 1px var(--it-edge-strong);
		color: var(--sl-color-gray-2);
	}
	q {
		color: var(--sl-color-white);
		quotes: '“' '”';
	}
</style>
