---
// The wordmark. The dot in "inject.today" is a status light: the site is
// about whether your tools are working today.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="wordmark" aria-label="Inject.Today, home">
	<span aria-hidden="true">inject</span><span class="light" aria-hidden="true"></span><span
		aria-hidden="true">today</span
	>
</a>

<style>
	.wordmark {
		display: inline-block;
		font-size: 1.0625rem;
		line-height: 1;
		font-weight: 650;
		letter-spacing: -0.035em;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
		-webkit-tap-highlight-color: transparent;
	}
	/* An empty inline-block sits on the baseline, exactly where a period would. */
	.light {
		display: inline-block;
		inline-size: 0.3125rem;
		block-size: 0.3125rem;
		margin-inline: 0.1rem 0.08rem;
		border-radius: 50%;
		background: var(--it-ok);
		box-shadow: 0 0 0 2.5px color-mix(in oklab, var(--it-ok) 22%, transparent);
		vertical-align: baseline;
	}
	.wordmark:focus-visible {
		outline: 2px solid var(--sl-color-white);
		outline-offset: 4px;
		border-radius: 0.25rem;
	}
</style>
