---
// Product pages get their mark, status and platforms next to the title;
// guides get a breadcrumb back to their product and their freshness info.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ProductMark from '../ProductMark.astro';
import StatusBadge from '../StatusBadge.astro';
import { formatDate } from '../../lib/guides';
import {
	categoryFor,
	kindLabel,
	platformsLabel,
	productForId,
	productHref,
} from '../../lib/products';

// Same id as Starlight's own title, which the skip link and table of contents point at.
const TITLE_ID = '_top';

const { id, entry } = Astro.locals.starlightRoute;
const product = productForId(id);
const isHome = id === '';
const isOverview = product !== undefined && id === product.slug;
const { appliesTo, verifiedOn, category } = entry.data;
---

{
	isHome ? (
		<h1 id={TITLE_ID} class="home-title">
			{entry.data.title}
		</h1>
	) : isOverview ? (
		<div class="overview-title">
			<ProductMark product={product} size="lg" />
			<div>
				<h1 id={TITLE_ID}>{product.name}</h1>
				<p class="overview-meta">
					<StatusBadge status={product.status} />
					<span>
						{platformsLabel(product)} · {kindLabel[product.kind]}
					</span>
				</p>
			</div>
		</div>
	) : product ? (
		<>
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href={productHref(product)}>{product.name}</a>
				<span aria-hidden="true">/</span>
				<span>{categoryFor(category).label}</span>
			</nav>
			<h1 id={TITLE_ID}>{entry.data.title}</h1>
			{(appliesTo || verifiedOn) && (
				<p class="guide-meta">
					{appliesTo && <span>Applies to {appliesTo}</span>}
					{verifiedOn && (
						<span>
							Verified <time datetime={verifiedOn.toISOString().slice(0, 10)}>{formatDate(verifiedOn)}</time>
						</span>
					)}
				</p>
			)}
		</>
	) : (
		<Default />
	)
}

<style>
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.home-title {
		margin-top: clamp(1rem, 6vh, 4rem);
		max-inline-size: 24ch;
		font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.overview-title {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1rem;
	}
	.overview-title h1 {
		margin: 0;
		letter-spacing: -0.01em;
	}
	.overview-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem 0.75rem;
		margin: 0.375rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.crumbs a {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--sl-color-white);
	}
	.crumbs + h1 {
		margin-top: 0.25rem;
	}

	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
