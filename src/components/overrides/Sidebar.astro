---
// On a product's pages, the sidebar starts with which product you're in and
// a way back to the full list.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import ProductIcon from '../ProductIcon.astro';
import { platformsLabel, productForId, productHref } from '../../lib/products';

const product = productForId(Astro.locals.starlightRoute.id);
---

{
	product && (
		<div class="product">
			<a class="back" href="/">
				<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
					<path
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.6"
						d="M10 3.5 5.5 8l4.5 4.5"
					/>
				</svg>
				All products
			</a>
			<a class="current" href={productHref(product)}>
				<ProductIcon product={product} size={36} loading="eager" />
				<span>
					<span class="name">{product.name}</span>
					<span class="it-meta">{platformsLabel(product)}</span>
				</span>
			</a>
		</div>
	)
}
<Default />

<style>
	.product {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		padding: 0.25rem 0 1.125rem;
		margin-bottom: 0.25rem;
		border-bottom: 1px solid var(--it-edge);
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		align-self: flex-start;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		transition: color 150ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.back:hover {
			color: var(--sl-color-white);
		}
	}
	.current {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.current > span {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-inline-size: 0;
	}
	.name {
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}
</style>
