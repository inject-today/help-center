---
// Home page: find your product by name or platform, or pick a featured one.
import ProductCard from './ProductCard.astro';
import { PLATFORMS, featuredProducts, products, repoUrl } from '../lib/products';

const suggestUrl = `${repoUrl}/issues/new?${new URLSearchParams({ title: 'Add product: ' })}`;
---

<div class="picker not-content" data-picker>
	<p class="lede">
		Pick your product to find fixes written and checked by the community.
	</p>

	<div class="controls">
		<label class="search">
			<span class="sr-only">Find your product</span>
			<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
				<path
					fill="currentColor"
					d="M21.71 20.29 18 16.61A9 9 0 1 0 16.61 18l3.68 3.68a1 1 0 0 0 1.42 0 1 1 0 0 0 0-1.39ZM11 18a7 7 0 1 1 7-7 7 7 0 0 1-7 7Z"
				></path>
			</svg>
			<input
				type="search"
				placeholder="Find your product"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
				enterkeyhint="go"
				aria-controls="product-list"
				data-query
			/>
			<kbd aria-hidden="true">/</kbd>
		</label>

		<div class="platforms" role="group" aria-label="Filter by platform">
			<button type="button" aria-pressed="true" data-platform="">All</button>
			{
				PLATFORMS.map((platform) => (
					<button type="button" aria-pressed="false" data-platform={platform}>
						{platform}
					</button>
				))
			}
		</div>
	</div>

	{
		featuredProducts.length > 0 && (
			<section class="section" aria-labelledby="featured-heading" data-featured>
				<h2 id="featured-heading">Popular</h2>
				<ul class="featured" role="list">
					{featuredProducts.map((product) => (
						<li>
							<ProductCard product={product} variant="feature" />
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="section" aria-labelledby="all-heading">
		<div class="section-head">
			<h2 id="all-heading">All products</h2>
			<p class="count" aria-live="polite" data-count>{products.length} products</p>
		</div>
		<ul class="list" id="product-list" role="list">
			{
				products.map((product) => (
					<li
						data-product
						data-name={product.name}
						data-platforms={product.platforms.join(' ')}
					>
						<ProductCard product={product} />
					</li>
				))
			}
		</ul>
		<div class="empty" data-empty hidden>
			<p>No product matches <strong data-empty-query></strong>.</p>
			<div class="empty-actions">
				<button type="button" class="it-action" data-variant="primary" data-search-guides>
					Search all guides
				</button>
				<a class="it-action" href={suggestUrl}>Suggest a product</a>
			</div>
		</div>
	</section>
</div>

<script>
	// Compact form so "synapsez" finds "Synapse Z" and "dx9" finds "DX9WARE V2".
	const compact = (value: string) => value.toLowerCase().replace(/[^a-z0-9]/g, '');

	for (const picker of document.querySelectorAll<HTMLElement>('[data-picker]')) {
		const input = picker.querySelector<HTMLInputElement>('[data-query]')!;
		const buttons = [...picker.querySelectorAll<HTMLButtonElement>('[data-platform]')];
		const items = [...picker.querySelectorAll<HTMLElement>('[data-product]')];
		const featured = picker.querySelector<HTMLElement>('[data-featured]');
		const count = picker.querySelector<HTMLElement>('[data-count]')!;
		const empty = picker.querySelector<HTMLElement>('[data-empty]')!;
		const emptyQuery = picker.querySelector<HTMLElement>('[data-empty-query]')!;
		const index = items.map((item) => ({
			item,
			name: compact(item.dataset.name!),
			platforms: item.dataset.platforms!.split(' '),
		}));
		let platform = '';

		const update = () => {
			const query = compact(input.value);
			let visible = 0;
			for (const { item, name, platforms } of index) {
				const match = name.includes(query) && (!platform || platforms.includes(platform));
				item.hidden = !match;
				if (match) visible++;
			}
			const filtering = query !== '' || platform !== '';
			if (featured) featured.hidden = filtering;
			count.textContent = `${visible} ${visible === 1 ? 'product' : 'products'}`;
			empty.hidden = visible > 0;
			emptyQuery.textContent = `“${input.value.trim() || platform}”`;
		};

		input.addEventListener('input', update);
		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter') {
				const first = index.find(({ item }) => !item.hidden);
				if (first && (input.value.trim() || platform)) {
					event.preventDefault();
					first.item.querySelector('a')?.click();
				}
			} else if (event.key === 'Escape' && input.value) {
				event.preventDefault();
				input.value = '';
				update();
			}
		});

		for (const button of buttons) {
			button.addEventListener('click', () => {
				platform = button.dataset.platform!;
				for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
				update();
			});
		}

		// "/" jumps to the product search, like most search boxes.
		document.addEventListener('keydown', (event) => {
			if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
			const target = event.target as HTMLElement;
			if (target.closest('input, textarea, select, [contenteditable="true"], dialog[open]')) return;
			event.preventDefault();
			input.focus();
		});

		// Hand the query over to the site-wide guide search.
		picker.querySelector('[data-search-guides]')?.addEventListener('click', (event) => {
			// Starlight closes its search dialog on any click outside it, including this one.
			event.stopPropagation();
			const query = input.value.trim();
			document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
			const searchInput = document.querySelector<HTMLInputElement>('#starlight__search input');
			if (searchInput && query) {
				searchInput.value = query;
				searchInput.dispatchEvent(new Event('input', { bubbles: true }));
			}
		});

		// Restore state when coming back with the browser's back button.
		if (input.value) update();
	}
</script>

<style>
	.picker {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.lede {
		margin: -0.5rem 0 0;
		max-inline-size: 36rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}

	.controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.search {
		position: relative;
		display: flex;
		align-items: center;
		flex: 1 1 18rem;
		max-inline-size: 30rem;
		color: var(--sl-color-gray-3);
	}
	.search svg {
		position: absolute;
		inset-inline-start: 0.875rem;
		pointer-events: none;
	}
	.search input {
		inline-size: 100%;
		block-size: 2.75rem;
		padding: 0 2.75rem 0 2.625rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		font: inherit;
		/* 16px+ stops iOS Safari from zooming into the field. */
		font-size: max(1rem, 16px);
		color: var(--sl-color-white);
		background: var(--sl-color-black);
		transition: border-color 150ms ease;
		-webkit-appearance: none;
		appearance: none;
	}
	.search input::placeholder {
		color: var(--sl-color-gray-3);
	}
	.search input::-webkit-search-cancel-button {
		display: none;
	}
	.search input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
		border-color: transparent;
	}
	.search kbd {
		position: absolute;
		inset-inline-end: 0.75rem;
		padding: 0 0.375rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-2xs);
		line-height: 1.5rem;
		color: var(--sl-color-gray-3);
		pointer-events: none;
	}
	.search input:focus ~ kbd,
	.search input:not(:placeholder-shown) ~ kbd {
		display: none;
	}
	@media (hover: none) {
		.search kbd {
			display: none;
		}
	}

	.platforms {
		display: inline-flex;
		gap: 0.125rem;
		padding: 0.1875rem;
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.platforms button {
		block-size: 2.25rem;
		padding: 0 0.875rem;
		border: 0;
		border-radius: 0.5625rem;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-gray-2);
		background: transparent;
		cursor: pointer;
		white-space: nowrap;
		transition:
			background-color 150ms ease,
			color 150ms ease,
			transform 160ms var(--it-ease-out);
		-webkit-tap-highlight-color: transparent;
	}
	.platforms button:active {
		transform: scale(0.96);
	}
	.platforms button[aria-pressed='true'] {
		color: var(--sl-color-white);
		background: var(--sl-color-black);
		box-shadow: var(--sl-shadow-sm);
	}
	.platforms button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	@media (hover: hover) and (pointer: fine) {
		.platforms button:hover:not([aria-pressed='true']) {
			color: var(--sl-color-white);
		}
	}

	.section h2 {
		margin: 0 0 1rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.count {
		margin: 0;
		font-size: var(--sl-text-xs);
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-3);
	}

	.featured,
	.list {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.featured {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@media (min-width: 50rem) {
		.featured {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.featured li,
	.list li {
		display: grid;
		min-inline-size: 0;
	}
	.list {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		gap: 0.125rem 1rem;
	}
	[hidden] {
		display: none !important;
	}

	.empty {
		padding: 2rem 1.25rem;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.75rem;
		text-align: center;
	}
	.empty p {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.empty strong {
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}
	.empty-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1rem;
	}
</style>
