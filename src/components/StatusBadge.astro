---
// A product's status from WEAO: a colored dot and a word. Hidden when WEAO
// doesn't list the product. The browser refreshes it from /api/status.
// Styles live in custom.css (.it-status), since the status panel builds the
// same badge in the browser.
import { getStatuses } from '../lib/status';
import { STATE_LABEL } from '../lib/weao.js';

interface Props {
	slug: string;
	/** Only show it when something is wrong, e.g. in a long list. */
	quiet?: boolean;
}

const { slug, quiet = false } = Astro.props;
const status = (await getStatuses())[slug];
const hidden = !status || (quiet && status.state === 'updated');
---

<span
	class="it-status"
	data-live-status={slug}
	data-quiet={quiet ? '' : undefined}
	data-state={status?.state}
	hidden={hidden}
>
	<span class="it-status-dot" aria-hidden="true"></span><span data-label
		>{status ? STATE_LABEL[status.state] : ''}</span
	>
</span>

<script>
	import '../scripts/live-status';
</script>
