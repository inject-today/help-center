---
import { statusLabel, type ProductStatus } from '../lib/products';

interface Props {
	status: ProductStatus;
}

const { status } = Astro.props;
---

<span class:list={['status', status]}>
	<span class="dot" aria-hidden="true"></span>{statusLabel[status]}
</span>

<style>
	.status {
		--tone: var(--it-ok);
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		font-size: var(--sl-text-xs);
		font-weight: 550;
		line-height: 1;
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
	.updating {
		--tone: var(--it-warn);
	}
	.down {
		--tone: var(--it-bad);
	}
	.dot {
		inline-size: 0.4375rem;
		block-size: 0.4375rem;
		border-radius: 50%;
		background: var(--tone);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--tone) 20%, transparent);
	}
</style>
