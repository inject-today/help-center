---
// Body of a product's overview page: its guides grouped by the kind of
// problem they solve, then what the real product looks like.
import { Image } from 'astro:assets';
import { formatDate, guideHref, guidesByCategory } from '../lib/guides';
import { reportFixUrl, screenshotFor, type Product } from '../lib/products';

interface Props {
	product: Product;
}

const { product } = Astro.props;
const groups = await guidesByCategory(product);
const total = groups.reduce((sum, group) => sum + group.guides.length, 0);
const screenshot = screenshotFor(product);
---

<div class="hub not-content">
	{
		total > 0 ? (
			<>
				{groups.length > 1 && (
					<nav class="jump" aria-label="Problem types">
						{groups.map(({ category, guides }) => (
							<a href={`#${category.id}`}>
								{category.label}
								<span class="it-meta">{guides.length}</span>
							</a>
						))}
					</nav>
				)}
				{groups.map(({ category, guides }) => (
					<section class="group" aria-labelledby={category.id}>
						<h2 id={category.id}>{category.label}</h2>
						<ul role="list">
							{guides.map((guide) => (
								<li>
									<a class="guide" href={guideHref(guide)}>
										<span class="guide-text">
											<span class="guide-title">{guide.data.title}</span>
											{guide.data.description && (
												<span class="guide-description">{guide.data.description}</span>
											)}
											{(guide.data.appliesTo || guide.data.verifiedOn) && (
												<span class="guide-meta it-meta">
													{guide.data.appliesTo && <span>{guide.data.appliesTo}</span>}
													{guide.data.verifiedOn && (
														<span>Verified {formatDate(guide.data.verifiedOn)}</span>
													)}
												</span>
											)}
										</span>
										<svg class="chevron" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
											<path
												fill="none"
												stroke="currentColor"
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="1.6"
												d="m6 3.5 4.5 4.5L6 12.5"
											/>
										</svg>
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
				<p class="more">
					Fixed something that isn't listed? <a href="/contributing/">Write a guide</a> or{' '}
					<a href={reportFixUrl(product)}>report the fix</a>.
				</p>
			</>
		) : (
			<div class="empty">
				<h2>No guides for {product.name} yet</h2>
				<p>
					If you've fixed a problem with {product.name}, writing it down here saves the next person
					from asking the same question in Discord.
				</p>
				<div class="empty-actions">
					<a class="it-action" data-variant="primary" href="/contributing/">
						Write the first guide
					</a>
					<a class="it-action" href={reportFixUrl(product)}>
						Report a fix instead
					</a>
				</div>
			</div>
		)
	}

	{
		screenshot && (
			<figure class="shot">
				<h2>What the real {product.name} looks like</h2>
				<div class="frame">
					<Image
						src={screenshot}
						alt={`The ${product.name} window`}
						widths={[480, 800, 1200, Math.min(1600, screenshot.width)]}
						sizes="(min-width: 50rem) 44rem, calc(100vw - 2rem)"
						loading="lazy"
						decoding="async"
					/>
				</div>
				<figcaption>
					If the {product.name} you downloaded looks very different, it may not be the real one. Only
					download it from its official links above. Screenshot from WEAO.
				</figcaption>
			</figure>
		)
	}

	<p class="note">
		Inject.Today isn't affiliated with {product.name} and never hosts downloads.
	</p>
</div>

<style>
	.hub {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
	}

	h2 {
		margin: 0 0 0.875rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}

	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-bottom: -1rem;
	}
	.jump a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		block-size: 2rem;
		padding: 0 0.75rem;
		border-radius: var(--it-radius-sm);
		background: var(--sl-color-gray-6);
		box-shadow: inset 0 0 0 1px var(--it-edge);
		font-size: var(--sl-text-sm);
		font-weight: 550;
		color: var(--sl-color-gray-1);
		text-decoration: none;
		transition:
			color 150ms ease,
			transform 160ms var(--it-ease-out);
		-webkit-tap-highlight-color: transparent;
	}
	.jump a:active {
		transform: scale(0.97);
	}
	@media (hover: hover) and (pointer: fine) {
		.jump a:hover {
			color: var(--sl-color-white);
		}
	}

	.group ul {
		margin: 0;
		padding: 0;
		list-style: none;
		border-radius: var(--it-radius);
		background: var(--it-surface);
		box-shadow: var(--it-shadow);
		overflow: hidden;
	}
	.group li + li {
		border-top: 1px solid var(--it-edge);
	}
	.guide {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.9375rem 1.125rem;
		color: var(--sl-color-white);
		text-decoration: none;
		transition: background-color 150ms ease;
		-webkit-tap-highlight-color: transparent;
	}
	.guide:focus-visible {
		outline: 2px solid var(--sl-color-white);
		outline-offset: -2px;
	}
	.guide-text {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
		min-inline-size: 0;
	}
	.guide-title {
		font-weight: 600;
		letter-spacing: -0.01em;
		text-wrap: pretty;
	}
	.guide-description {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		margin-top: 0.125rem;
	}
	.chevron {
		flex-shrink: 0;
		color: var(--sl-color-gray-4);
		transition: transform 200ms var(--it-ease-out);
	}
	@media (hover: hover) and (pointer: fine) {
		.guide:hover {
			background: var(--it-surface-raised);
		}
		.guide:hover .chevron {
			transform: translateX(2px);
		}
	}

	.more,
	.note {
		margin: 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.more a {
		color: var(--sl-color-gray-1);
		text-decoration: underline;
		text-decoration-color: var(--sl-color-gray-4);
		text-underline-offset: 0.2em;
	}
	.more a:hover {
		color: var(--sl-color-white);
		text-decoration-color: currentColor;
	}
	.note {
		margin-top: -1rem;
		font-size: var(--sl-text-xs);
	}

	.empty {
		padding: 1.75rem;
		border-radius: var(--it-radius-lg);
		background: var(--it-surface);
		box-shadow: var(--it-shadow);
	}
	.empty h2 {
		margin-bottom: 0.375rem;
	}
	.empty p {
		margin: 0;
		max-inline-size: 32rem;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.empty-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.375rem;
	}

	.shot {
		margin: 0;
	}
	.frame {
		border-radius: var(--it-radius);
		overflow: hidden;
		background: hsl(228 12% 8%);
		box-shadow:
			inset 0 0 0 1px var(--it-edge),
			var(--it-shadow-lift);
	}
	.frame :global(img) {
		display: block;
		inline-size: 100%;
		block-size: auto;
	}
	figcaption {
		margin-top: 0.875rem;
		max-inline-size: 38rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-wrap: pretty;
	}

	@media (prefers-reduced-motion: reduce) {
		.jump a:active {
			transform: none;
		}
		.chevron,
		.guide:hover .chevron {
			transition: none;
			transform: none;
		}
	}
</style>
