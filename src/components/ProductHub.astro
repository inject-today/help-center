---
// Body of a product's overview page: official links, then every guide
// grouped by the kind of problem it solves.
import { formatDate, guideHref, guidesByCategory } from '../lib/guides';
import { reportFixUrl, type Product } from '../lib/products';

interface Props {
	product: Product;
}

const { product } = Astro.props;
const groups = await guidesByCategory(product);
const total = groups.reduce((sum, group) => sum + group.guides.length, 0);
const officialLinks = [
	{ label: 'Official website', href: product.links.website },
	{ label: 'Official Discord', href: product.links.discord },
].filter((link) => link.href);
---

<div class="hub not-content">
	<div class="links">
		{
			officialLinks.map(({ label, href }) => (
				<a class="pill" href={href} target="_blank" rel="noopener noreferrer nofollow">
					{label}
					<svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12">
						<path
							fill="none"
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="1.5"
							d="M5.5 3.5h7v7M12 4l-8 8"
						/>
					</svg>
				</a>
			))
		}
		<a class="pill" href={reportFixUrl(product)}>Report a fix</a>
	</div>

	{
		total > 0 ? (
			<>
				{groups.length > 1 && (
					<nav class="jump" aria-label="Problem types">
						{groups.map(({ category, guides }) => (
							<a href={`#${category.id}`}>
								{category.label}
								<span class="tally">{guides.length}</span>
							</a>
						))}
					</nav>
				)}
				{groups.map(({ category, guides }) => (
					<section class="group" aria-labelledby={category.id}>
						<h2 id={category.id}>{category.label}</h2>
						<ul role="list">
							{guides.map((guide) => (
								<li>
									<a class="guide" href={guideHref(guide)}>
										<span class="guide-title">{guide.data.title}</span>
										{guide.data.description && (
											<span class="guide-description">{guide.data.description}</span>
										)}
										{(guide.data.appliesTo || guide.data.verifiedOn) && (
											<span class="guide-meta">
												{guide.data.appliesTo && <span>{guide.data.appliesTo}</span>}
												{guide.data.verifiedOn && (
													<span>Verified {formatDate(guide.data.verifiedOn)}</span>
												)}
											</span>
										)}
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
			</>
		) : (
			<div class="empty">
				<p class="empty-title">No guides for {product.name} yet</p>
				<p>
					Fixed a problem with {product.name}? Write it down so the next person doesn't have to
					dig through Discord for the answer.
				</p>
				<div class="empty-actions">
					<a class="it-action" data-variant="primary" href="/contributing/">
						Write the first guide
					</a>
					<a class="it-action" href={reportFixUrl(product)}>
						Report a fix instead
					</a>
				</div>
			</div>
		)
	}

	<p class="note">
		Only download {product.name} from its official links. Inject.Today isn't affiliated with{' '}
		{product.name} and never hosts downloads.
	</p>
</div>

<style>
	.hub {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.links,
	.jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.pill,
	.jump a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		block-size: 2rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-white);
		text-decoration: none;
		transition:
			background-color 150ms ease,
			transform 160ms var(--it-ease-out);
		-webkit-tap-highlight-color: transparent;
	}
	.pill:active,
	.jump a:active {
		transform: scale(0.97);
	}
	.pill svg {
		color: var(--sl-color-gray-3);
	}
	.jump a {
		border-color: transparent;
		background: var(--sl-color-gray-6);
	}
	.tally {
		font-size: var(--sl-text-xs);
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-3);
	}
	@media (hover: hover) and (pointer: fine) {
		.pill:hover {
			background: var(--sl-color-gray-6);
		}
		.jump a:hover {
			background: var(--sl-color-gray-5);
		}
	}

	.group h2 {
		margin: 0 0 0.75rem;
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-white);
		scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem);
	}
	.group ul {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		overflow: hidden;
	}
	.group li + li {
		border-top: 1px solid var(--sl-color-hairline-light);
	}
	.guide {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding: 0.75rem 1rem;
		color: var(--sl-color-white);
		text-decoration: none;
		transition: background-color 150ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.guide:hover {
			background: var(--sl-color-gray-6);
		}
	}
	.guide:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
		border-radius: 0.75rem;
	}
	.guide-title {
		font-weight: 600;
	}
	.guide-description {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.75rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.empty {
		padding: 2rem 1.5rem;
		border: 1px dashed var(--sl-color-gray-5);
		border-radius: 0.75rem;
	}
	.empty p {
		margin: 0;
		max-inline-size: 34rem;
		color: var(--sl-color-gray-2);
	}
	.empty .empty-title {
		margin-bottom: 0.375rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.empty-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.note {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
